<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- AMR 1 (Dock 1) -->
<model name="amr_1">
  <!-- z lowered from 0.8 -> 0.65 so the wheel bottoms sit exactly on the
       ground plane at spawn (chassis_z + wheel_z - wheel_radius = 0),
       instead of dropping 0.15 m before settling. -->
  <pose>-13 -1 0.65 0 0 0</pose>

  <link name="chassis">
    <visual name="v"><geometry><box><size>1.5 1.0 0.8</size></box></geometry><material><diffuse>1.0 0.7 0.0 1</diffuse><pbr><metal><albedo_color>1.0 0.7 0.0 1</albedo_color></metal></pbr></material></visual>
    <collision name="c"><geometry><box><size>1.5 1.0 0.8</size></box></geometry></collision>
    <!-- Corrected box inertia: Ixx=1/12 m(y^2+z^2), Iyy=1/12 m(x^2+z^2), Izz=1/12 m(x^2+y^2) for a 1.5x1.0x0.8 m, 50 kg box -->
    <inertial><mass>50</mass><inertia><ixx>6.833</ixx><iyy>12.042</iyy><izz>13.542</izz></inertia></inertial>
    <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.5 0 0 0</pose><update_rate>20</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.3</min><max>15.0</max></range></ray><always_on>1</always_on><visualize>true</visualize></sensor>
    <visual name="lidar_vis"><pose>0 0 0.5 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.2</length></cylinder></geometry><material><diffuse>1.0 0.3 0.0 1</diffuse><pbr><metal><albedo_color>1.0 0.3 0.0 1</albedo_color></metal></pbr></material></visual>
  </link>

  <!-- DRIVEN WHEELS: moved onto the chassis centerline (x=0). A wheel at
       (0, y) has purely tangential (rolling-direction) contact velocity
       during in-place rotation, so turning needs zero lateral slip -
       the old x=+-0.5 offset was exactly what forced the wheels to
       slide sideways and stall the turn no matter how much friction
       was added. -->
  <link name="left_wheel">
    <pose>0 0.6 -0.3 -1.5707 0 0</pose>
    <visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
    <collision name="c">
      <geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry>
      <!-- fdir1 is expressed in this link's local frame, where the cylinder's
           rolling direction is still local X (the -1.5707 pose only re-aims
           the spin axis in world space, it doesn't touch the collision's
           own frame). mu is now a physically sane rolling-friction value;
           mu2 (lateral) can stay modest since these wheels no longer need
           to slip sideways to turn. -->
      <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
    </collision>
    <!-- Cylinder inertia about its own axis (local Z, = spin axis): Izz=1/2 m r^2.
         Transverse: Ixx=Iyy=1/12 m(3r^2+h^2), for r=0.35, h=0.2, m=5 -->
    <inertial><mass>5</mass><inertia><ixx>0.170</ixx><iyy>0.170</iyy><izz>0.306</izz></inertia></inertial>
  </link>
  <link name="right_wheel">
    <pose>0 -0.6 -0.3 -1.5707 0 0</pose>
    <visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
    <collision name="c">
      <geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry>
      <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
    </collision>
    <inertial><mass>5</mass><inertia><ixx>0.170</ixx><iyy>0.170</iyy><izz>0.306</izz></inertia></inertial>
  </link>

  <!-- CASTER WHEELS: passive, low-friction spheres replacing the old
       front/rear driven wheels. A sphere has no preferred rolling axis,
       so it slides freely under the chassis instead of resisting yaw -
       this is what let the old 4-wheel layout fight itself during a
       turn. Radius chosen so the sphere center sits at ground height
       (0.65 model z - 0.5 link z = 0.15 = radius), matching the drive
       wheels' ground contact. -->
  <link name="front_caster">
    <pose>0.6 0 -0.5 0 0 0</pose>
    <visual name="v"><geometry><sphere><radius>0.15</radius></sphere></geometry><material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    <collision name="c">
      <geometry><sphere><radius>0.15</radius></sphere></geometry>
      <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
    </collision>
    <inertial><mass>1</mass><inertia><ixx>0.009</ixx><iyy>0.009</iyy><izz>0.009</izz></inertia></inertial>
  </link>
  <link name="rear_caster">
    <pose>-0.6 0 -0.5 0 0 0</pose>
    <visual name="v"><geometry><sphere><radius>0.15</radius></sphere></geometry><material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    <collision name="c">
      <geometry><sphere><radius>0.15</radius></sphere></geometry>
      <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
    </collision>
    <inertial><mass>1</mass><inertia><ixx>0.009</ixx><iyy>0.009</iyy><izz>0.009</izz></inertia></inertial>
  </link>

  <joint name="left_j" type="revolute"><parent>chassis</parent><child>left_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
  <joint name="right_j" type="revolute"><parent>chassis</parent><child>right_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
  <!-- Casters are rigidly attached; they're frictionless spheres, not
       articulated swivel wheels, so no revolute axis is needed - they
       just slide. -->
  <joint name="front_caster_j" type="fixed"><parent>chassis</parent><child>front_caster</child></joint>
  <joint name="rear_caster_j" type="fixed"><parent>chassis</parent><child>rear_caster</child></joint>

  <!-- Only two driven joints now, one per side. wheel_separation matches
       the true 1.2 m track directly - no inflation factor needed, since
       the centerline wheel placement above removes the systematic slip
       that previously required fudging this number. -->
  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <left_joint>left_j</left_joint>
    <right_joint>right_j</right_joint>
    <wheel_separation>1.2</wheel_separation>
    <wheel_radius>0.35</wheel_radius>
    <odom_publish_frequency>0</odom_publish_frequency>
    <!-- Belt-and-suspenders: don't rely on odom_publish_frequency=0 alone
         to keep this off the real odometry topic - whether 0 fully
         disables publishing isn't something I can confirm from here, and
         last time this was still what showed up on
         /model/<name>/odometry. Renaming its topic outright guarantees no
         collision with OdometryPublisher below regardless of that
         semantics. This topic is intentionally not bridged by anything -
         it's DiffDrive's required internal odometry output, not data
         you're meant to consume. -->
    <odom_topic>_unused_wheel_odom</odom_topic>
  </plugin>

  <!-- Ground-truth odometry from the model's actual world pose, instead
       of integrating wheel-joint angles. This is what was masking the
       yaw problem: DiffDrive's own odometry assumed the wheels' commanded
       rotation equals the chassis's actual rotation, which was false
       under skid on the old 4-wheel layout. Bridge this topic and feed
       it into node.current_x/y/yaw so LocalPlanner sees reality. -->
  <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
    <odom_publish_frequency>50</odom_publish_frequency>
  </plugin>

  <!-- Battery plugin disabled for testing. The closing </plugin> tag is now
       inside this comment too - previously it was left outside, which is
       an orphaned closing tag with no matching opener (invalid XML). That
       almost certainly broke this file's parse, which is the actual
       reason your odometry fix wasn't taking effect: Gazebo was very
       likely still running on a stale/previous model definition rather
       than this file.
  <plugin filename="gz-sim-linear-battery-system" name="gz::sim::systems::LinearBattery">
  <battery_name>amr_battery</battery_name>
  <voltage>24.0</voltage>
  <open_circuit_voltage_constant_coeff>24.0</open_circuit_voltage_constant_coeff>
  <open_circuit_voltage_linear_coeff>-4.0</open_circuit_voltage_linear_coeff>
  <initial_charge>24.0</initial_charge>
  <capacity>24.0</capacity>
  <resistance>0.05</resistance>
  <smooth_current_tau>1.98</smooth_current_tau>
  <power_load>15.0</power_load>
  <charging_voltage>26.0</charging_voltage>
  </plugin> -->
</model>
</sdf>