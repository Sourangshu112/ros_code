<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- AMR 1 (Dock 1) -->
<model name="amr_1">
  <pose>-13 -1 0.8 0 0 0</pose>
  <link name="chassis">
    <visual name="v"><geometry><box><size>1.5 1.0 0.8</size></box></geometry><material><diffuse>1.0 0.7 0.0 1</diffuse><pbr><metal><albedo_color>1.0 0.7 0.0 1</albedo_color></metal></pbr></material></visual>
    <collision name="c"><geometry><box><size>1.5 1.0 0.8</size></box></geometry></collision>
    <inertial><mass>50</mass><inertia><ixx>5</ixx><iyy>10</iyy><izz>12</izz></inertia></inertial>
    <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.5 0 0 0</pose><update_rate>20</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.3</min><max>15.0</max></range></ray><always_on>1</always_on><visualize>true</visualize></sensor>
    <visual name="lidar_vis"><pose>0 0 0.5 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.2</length></cylinder></geometry><material><diffuse>1.0 0.3 0.0 1</diffuse><pbr><metal><albedo_color>1.0 0.3 0.0 1</albedo_color></metal></pbr></material></visual>
  </link>
  <link name="fl_wheel"><pose>0.5 0.6 -0.3 -1.5707 0 0</pose><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry></collision><inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial></link>
  <link name="fr_wheel"><pose>0.5 -0.6 -0.3 -1.5707 0 0</pose><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry></collision><inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial></link>
  <link name="rl_wheel"><pose>-0.5 0.6 -0.3 -1.5707 0 0</pose><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry></collision><inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial></link>
  <link name="rr_wheel"><pose>-0.5 -0.6 -0.3 -1.5707 0 0</pose><visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry></collision><inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial></link>
  <joint name="fl_j" type="revolute"><parent>chassis</parent><child>fl_wheel</child><axis><xyz>0 0 1</xyz></axis></joint><joint name="fr_j" type="revolute"><parent>chassis</parent><child>fr_wheel</child><axis><xyz>0 0 1</xyz></axis></joint><joint name="rl_j" type="revolute"><parent>chassis</parent><child>rl_wheel</child><axis><xyz>0 0 1</xyz></axis></joint><joint name="rr_j" type="revolute"><parent>chassis</parent><child>rr_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>fl_j</left_joint><left_joint>rl_j</left_joint><right_joint>fr_j</right_joint><right_joint>rr_j</right_joint><wheel_separation>1.2</wheel_separation><wheel_radius>0.35</wheel_radius></plugin>
  <plugin filename="gz-sim-linear-battery-system" name="gz::sim::systems::LinearBattery">
  <battery_name>amr_battery</battery_name>
  <voltage>24.0</voltage>
  <open_circuit_voltage_constant_coeff>24.0</open_circuit_voltage_constant_coeff>
  <open_circuit_voltage_linear_coeff>-4.0</open_circuit_voltage_linear_coeff>
  <initial_charge>24.0</initial_charge>
  <capacity>24.0</capacity>
  <resistance>0.05</resistance>
  <smooth_current_tau>1.98</smooth_current_tau>
  <power_load>15.0</power_load>
  <charging_voltage>26.0</charging_voltage>
</plugin>
</model>
</sdf>
